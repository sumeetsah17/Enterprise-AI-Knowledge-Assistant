# ==========================================
# Enterprise RAG - Git Ignore
# ==========================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*
!.env.example

# Node
node_modules/
frontend/node_modules/

# Build outputs
dist/
build/
*.egg-info/

# Vite
frontend/dist/
frontend/.vite/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs
*.log

# Database files
*.db
*.sqlite
*.sqlite3

# Runtime uploaded documents
backend/uploads/

# macOS / Windows
.DS_Store
Thumbs.db

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temporary files
*.tmp
*.temp

# Jupyter
.ipynb_checkpoints/

# Project backups / archives
backend copy/
untitled folder/
